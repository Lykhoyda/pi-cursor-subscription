{
  "name": "@lykhoyda/pi-cursor-subscription",
  "version": "1.5.1",
  "description": "Cursor provider for Pi Coding Agent. Fork of @rahularya01/pi-cursor with privileged native exec off by default.",
  "author": "Anton Lykhoyda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lykhoyda/pi-cursor-subscription.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Lykhoyda/pi-cursor-subscription#readme",
  "bugs": {
    "url": "https://github.com/Lykhoyda/pi-cursor-subscription/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "cursor",
    "oauth",
    "provider"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepare": "bun run build || node scripts/prepare.mjs",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "security-check": "bun scripts/security-check.ts",
    "proto:gen": "buf generate",
    "proto:sync": "bun scripts/proto-sync.ts",
    "proto:check": "bun scripts/proto-check.ts",
    "test": "bun test --timeout=15000",
    "test:coverage": "bun test --coverage --timeout=15000 && bun scripts/coverage-threshold.ts",
    "test:watch": "bun test --watch --timeout=15000",
    "test:legacy": "bun scripts/test-model-routing.ts && bun scripts/test-thinking-levels.ts && bun scripts/test-usage.ts && bun scripts/test-context-mode-normalize.ts && bun scripts/test-cli-auth.ts",
    "smoke:auth": "bun scripts/smoke-auth.mjs",
    "smoke:models": "bun scripts/smoke-models.mjs",
    "smoke:stream": "bun scripts/smoke-stream.mjs",
    "smoke:wire": "bun scripts/smoke-wire.mjs",
    "check": "bun run typecheck && bun run lint && bun run security-check && bun run proto:check && bun run test && bun run test:legacy",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.1.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.0"
}
